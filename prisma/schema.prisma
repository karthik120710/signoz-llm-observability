// SHOGO:CUSTOM-START prisma-header
// Managed by Shogo. Do not add a datasource `url` or change the generator `provider` — the database URL is configured in prisma.config.ts (Prisma 7+).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
// SHOGO:CUSTOM-END

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model LLMUsage {
  id            String   @id @default(cuid())
  provider      String
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  cost          Float    @default(0)
  latencyMs     Int      @default(0)
  status        String   @default("success")
  agentName     String?
  sessionId     String?
  traceId       String?
  spanId        String?
  errorMessage  String?
  metadata      String?
  createdAt     DateTime @default(now())

  @@map("llm_usage")
}

model BudgetRule {
  id            String   @id @default(cuid())
  name          String
  scope         String   @default("global")
  scopeValue    String?
  limitType     String   @default("daily")
  maxTokens     Int?
  maxCost       Float?
  alertThreshold Float  @default(0.8)
  action        String   @default("alert")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("budget_rules")
}

model BudgetAlert {
  id            String   @id @default(cuid())
  ruleId        String
  ruleName      String
  alertType     String
  currentTokens Int      @default(0)
  currentCost   Float    @default(0)
  limitTokens   Int?
  limitCost     Float?
  threshold     Float
  message       String
  acknowledged  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("budget_alerts")
}

model SREIncident {
  id              String   @id @default(cuid())
  sigNozAlertId   String?
  title           String
  description     String
  severity        String   @default("warning")
  status          String   @default("open")
  service         String?
  rootCause       String?
  hypothesis      String?
  resolution      String?
  affectedTraces  String?
  sigNozQuery     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("sre_incidents")
}

model SigNozConfig {
  id            String   @id @default(cuid())
  instanceUrl   String
  apiKey        String
  region        String   @default("us")
  mcpEnabled    Boolean  @default(false)
  mcpUrl        String?
  connected     Boolean  @default(false)
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("signoz_configs")
}
